//
// Compilation list for the fork-local CV-X-IF derived package.
//
// The vendored uvma_cvxif_pkg is compiled first (base-class library); the
// fork-local package below imports it.  The vendored pkg includes the stub
// files uvme_cvxif_base_vseq.sv / uvme_cvxif_vseq.sv (provided in this same
// directory); the extra +incdir ensures those stubs resolve via the include
// path regardless of the current working directory.

// Directories
+incdir+${DV_UME_CVXIF_PATH}
+incdir+${DV_UVMA_CVXIF_PATH}
+incdir+${DV_UVMA_CVXIF_PATH}/src
+incdir+${DV_UVMA_CVXIF_PATH}/src/comps
+incdir+${DV_UVMA_CVXIF_PATH}/src/obj
+incdir+${DV_UVMA_CVXIF_PATH}/src/seq

// Vendored CV-X-IF agent base library (fast: compiles the stub vseq includes)
-f ${DV_UVMA_CVXIF_PATH}/src/uvma_cvxif_pkg.flist

// Fork-local derived package
${DV_UME_CVXIF_PATH}/uvme_cvxif_pkg.sv
